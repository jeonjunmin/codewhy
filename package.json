{
  "name": "codewhy",
  "displayName": "CodeWhy",
  "description": "AI 기반 코드 컨텍스트 분석 - 컨텍스트 블레임, 타임라인 요약, 요구사항 역추적",
  "version": "0.0.1",
  "icon": "images/icon-128.png",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codewhy",
          "title": "CodeWhy",
          "icon": "images/codewhy-icon.svg"
        }
      ]
    },
    "views": {
      "codewhy": [
        {
          "type": "webview",
          "id": "codewhy.contextBlame",
          "name": "CodeWhy",
          "icon": "images/codewhy-icon.svg",
          "contextualTitle": "CodeWhy"
        }
      ]
    },
    "commands": [
      {
        "command": "codewhy.contextBlame",
        "title": "CodeWhy: 이 코드, 왜 바꿨어? (Context Blame)"
      },
      {
        "command": "codewhy.timelineSummary",
        "title": "CodeWhy: 이 파일의 역사 요약 (Timeline Summary)"
      },
      {
        "command": "codewhy.requirementTrace",
        "title": "CodeWhy: 원본 기획서 찾기 (Requirement Trace)"
      },
      {
        "command": "codewhy.blame.openCommit",
        "title": "CodeWhy: 커밋 상세 보기"
      },
      {
        "command": "codewhy.blame.pin",
        "title": "CodeWhy: 현재 라인 블레임 고정/해제"
      },
      {
        "command": "codewhy.openSettings",
        "title": "CodeWhy: 설정 열기",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "codewhy.blame.pin",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codewhy.openSettings",
          "when": "view == codewhy.contextBlame",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codewhy.contextBlame",
          "group": "codewhy@1"
        },
        {
          "command": "codewhy.timelineSummary",
          "group": "codewhy@2"
        },
        {
          "command": "codewhy.requirementTrace",
          "group": "codewhy@3"
        }
      ]
    },
    "configuration": {
      "title": "CodeWhy",
      "properties": {
        "codewhy.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "에디터 라인에 '🔍 왜 바꿨어?' CodeLens 표시 여부"
        },
        "codewhy.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "분석된 라인 위에 마우스를 올렸을 때 블레임 요약 팝업 표시 여부"
        },
        "codewhy.backendUrl": {
          "type": "string",
          "default": "https://api.codewhy.example.com",
          "markdownDescription": "**[고급]** CodeWhy 백엔드 서버 URL. 일반 사용자는 변경할 필요가 없으며, 자체 호스팅(self-hosted) 백엔드를 사용할 때만 수정합니다.",
          "order": 100
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "backend:install": "python -m pip install -r backend/requirements.txt",
    "backend:dev": "python -m uvicorn app.main:app --reload --port 8000 --app-dir backend"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.16.0"
  }
}

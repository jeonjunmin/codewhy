# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# AWS Bedrock (컨텍스트 블레임 RAG)
# Converse API 모델 ID (inference profile ID 권장)
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
# 기획서 단락을 조회할 Knowledge Base ID (미설정 시 RAG 생략)
BEDROCK_KNOWLEDGE_BASE_ID=
# KB 한 번 조회 시 가져올 단락 수
BEDROCK_KB_MAX_RESULTS=4

# DynamoDB 테이블명
DYNAMO_BLAME_TABLE=codewhy_blame_cache
DYNAMO_TIMELINE_TABLE=codewhy_timeline_cache

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# 기획서/문서 폴더 경로 (쉼표 구분)
DOCUMENT_PATHS=/path/to/docs,/path/to/specs

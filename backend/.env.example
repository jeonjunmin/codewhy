# ══════════════════════════════════════════════════════════════════════════════
#  CodeWhy 백엔드 환경변수 양식
#  이 파일을 복사해 backend/.env 를 만들고 실제 값을 채워 넣으세요.
# ══════════════════════════════════════════════════════════════════════════════

# ── AWS 공통 ─────────────────────────────────────────────────────────────────
# EC2 배포 시: IAM Instance Profile → 아래 두 값 비워두어도 됩니다.
# 로컬 개발 시: IAM 사용자 키 (권한: bedrock:InvokeModel, dynamodb:*)
AWS_DEFAULT_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# AWS Console → Bedrock → Model access 에서 모델을 먼저 활성화해야 합니다.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ── AWS DynamoDB ──────────────────────────────────────────────────────────────
# 커밋 로그 저장 테이블 (스키마: app/db/dynamo_schema.py 참고)
DYNAMODB_COMMIT_TABLE=codewhy_commit_logs

# 로컬 Docker DynamoDB 엔드포인트:
#   docker run -p 8001:8000 amazon/dynamodb-local
# 실제 AWS 사용 시 빈 값으로 두세요.
DYNAMODB_ENDPOINT_URL=

# blame/traceability 결과 캐시 테이블
DYNAMO_BLAME_TABLE=codewhy_blame_cache
DYNAMO_TIMELINE_TABLE=codewhy_timeline_cache

# ── Anthropic API (Context Blame / Requirement Trace 전용) ────────────────────
ANTHROPIC_API_KEY=

# ── 기타 ─────────────────────────────────────────────────────────────────────
DOCUMENT_PATHS=

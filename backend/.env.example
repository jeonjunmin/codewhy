# ══════════════════════════════════════════════════════════════════════════════
#  CodeWhy 백엔드 환경변수 양식
#  이 파일을 복사해 backend/.env 를 만들고 실제 값을 채워 넣으세요.
# ══════════════════════════════════════════════════════════════════════════════

# ── AWS 공통 ─────────────────────────────────────────────────────────────────
# EC2 배포 시: IAM Instance Profile → 아래 두 값 비워두어도 됩니다.
# 로컬 개발 시: IAM 사용자 키 (권한: bedrock:InvokeModel)
AWS_DEFAULT_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# AWS Console → Bedrock → Model access 에서 모델을 먼저 활성화해야 합니다.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ── Bedrock Knowledge Base (RAG: 블레임 단락 조회 + 역추적 시맨틱 매칭) ──────────
# 미설정 시 RAG/시맨틱 경로를 생략하고 티켓·수동 링크만으로 동작합니다.
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_KB_MAX_RESULTS=4

# ── 브라운필드(SM) 온보딩: 문서 인덱싱 + 커밋 백필 ─────────────────────────────
# 레거시 문서 더미를 시맨틱 검색하려면 KB 데이터소스(S3)에 적재해야 합니다.
# DOC_INDEX_S3_BUCKET 미설정 시 인덱싱은 no-op(=티켓/수동 링크만 동작).
DOC_INDEX_S3_BUCKET=
DOC_INDEX_S3_PREFIX=codewhy-docs/
# ingestion job 을 트리거할 KB 데이터소스 ID (미설정 시 자동 ingestion 생략)
BEDROCK_KB_DATA_SOURCE_ID=
# 커밋↔문서 백필 시 링크를 생성할 최소 시맨틱 점수(0~1)
TRACE_BACKFILL_MIN_CONFIDENCE=0.4

# ── PostgreSQL (RDS) ──────────────────────────────────────────────────────────
# 런타임은 asyncpg 드라이버를 사용합니다. Alembic 은 이 값에서 +asyncpg → +psycopg2 로
# 자동 치환해 동기 접속합니다(app/core/config.py:get_rds_url_sync).
#   로컬 Docker:  docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codewhy

# ── 기타 ─────────────────────────────────────────────────────────────────────
# 업로드된 기획 문서 바이너리를 보관할 서버 디렉터리 (역추적 다운로드용)
DOCUMENTS_DIR=./uploaded_documents

# 작성자 → 팀 매핑 JSON 파일 경로 (미설정 시 team 칸 생략)
# 예시는 backend/team_map.example.json 참고
CODEWHY_TEAM_MAP=/path/to/team_map.json

# 호스팅 PR/MR 조회 토큰 (미설정 시 '동일 PR N 라인' · 같은-PR 관련 변경 생략)
GITHUB_TOKEN=
GITLAB_TOKEN=

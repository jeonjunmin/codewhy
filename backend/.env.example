# ══════════════════════════════════════════════════════════════════════════════
#  CodeWhy 백엔드 환경변수 양식
#  이 파일을 복사해 backend/.env 를 만들고 실제 값을 채워 넣으세요.
#  backend/.env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다.
# ══════════════════════════════════════════════════════════════════════════════

# ── AWS 공통 ─────────────────────────────────────────────────────────────────
# EC2 배포 시: IAM Instance Profile 을 사용하므로 아래 두 값은 비워두어도 됩니다.
# 로컬 개발 시: IAM 사용자 키를 입력하세요. (권한: bedrock:InvokeModel, dynamodb:*)
AWS_DEFAULT_REGION=ap-northeast-2   # boto3 표준 환경변수명
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# 사용 전 AWS Console → Bedrock → Model access 에서 모델을 활성화해야 합니다.
# Claude 3.5 Sonnet (권장):
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── AWS RDS (PostgreSQL) ──────────────────────────────────────────────────────
# asyncpg 드라이버 (FastAPI 앱용)
RDS_URL=postgresql+asyncpg://username:password@your-rds-endpoint:5432/codewhy
# psycopg2 드라이버 (alembic 마이그레이션 전용)
RDS_URL_SYNC=postgresql+psycopg2://username:password@your-rds-endpoint:5432/codewhy

# ── AWS DynamoDB (blame/traceability 결과 캐시) ───────────────────────────────
DYNAMO_BLAME_TABLE=codewhy_blame_cache
DYNAMO_TIMELINE_TABLE=codewhy_timeline_cache

# ── Anthropic API (Context Blame / Requirement Trace 기능) ────────────────────
ANTHROPIC_API_KEY=

# ── 기타 ─────────────────────────────────────────────────────────────────────
# 로컬에서 alembic 없이 테이블 자동 생성 (개발 전용)
AUTO_CREATE_TABLES=false
DOCUMENT_PATHS=
